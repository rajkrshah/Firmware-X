{
  "name": "firmwarex",
  "version": "1.0.0",
  "description": "Cross-platform firmware decompilation & analysis tool — Layer-by-layer extraction, multi-architecture disassembly, entropy analysis, and more.",
  "main": "server.js",
  "bin": {
    "firmwarex": "./cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "cli": "node cli.js",
    "dev": "node server.js --dev",
    "setup": "node setup.js",
    "test": "echo \"Run: node cli.js detect test/sample.bin\" && exit 0"
  },
  "keywords": [
    "firmware",
    "decryption",
    "decompilation",
    "reverse-engineering",
    "binary-analysis",
    "disassembly",
    "hex-viewer",
    "entropy",
    "ELF",
    "PE",
    "ARM",
    "MIPS",
    "x86"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.3",
    "commander": "^11.0.0",
    "express": "^4.22.2",
    "fflate": "^0.8.0",
    "jszip": "^3.10.0",
    "open": "^8.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32",
    "linux",
    "darwin"
  ]
}
